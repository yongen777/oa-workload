{
  "_说明": "复制为 settings.json 后填写。改完不需要重启任何服务。",

  "workspace_root": "C:/Users/lenovo/OA",
  "_workspace_root说明": "你的工时工作区绝对路径。留空脚本会拒绝写盘。",

  "default_project": "",
  "profile": "soft_dev",
  "_profile可选": ["soft_dev", "delivery", "product", "solution"],

  "quota": {
    "mode": "block",
    "_mode说明": "block = 不达标拒绝出单（硬约束）；warn = 照出但标红条（软约束）",
    "month_min": 30,
    "week_min": 8,
    "count_unit": "deliverable_qty",
    "sanity": {
      "max_files_per_deliverable": 5,
      "max_qty_per_day": 12
    }
  },

  "paths": {
    "week_label": "W_{s:%m%d}-{e:%m%d}",
    "_week_label说明": "不要用 ISO 周序号。日期区间不会错位。",
    "month_label": "{:%Y-%m}",
    "date_label": "{:%Y-%m-%d}",
    "ledger_dir": "_ledger",
    "weekly_package_dir": "_Weekly_Submit_Package",
    "ledger_in_project": false,
    "_ledger_in_project说明": "true 会把台账收进项目目录；跨月统计会断，一般保持 false"
  },

  "guards": {
    "require_workspace_root": true,
    "block_on_empty_dictionaries": false
  },

  "desensitize": {
    "enabled": true,
    "patterns": [
      "(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)",
      "(?i)(?:password|passwd|pwd|token|secret)\\s*[=:]\\s*\\S+",
      "1[3-9]\\d{9}"
    ],
    "_patterns说明": "内网 IP / 密码类 / 手机号。可自行增删。"
  }
}
